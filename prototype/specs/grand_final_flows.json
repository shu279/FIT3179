{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 360,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": 5,
  "config": {
    "background": "transparent",
    "font": "Helvetica Neue, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "tickColor": "#dedfd4",
      "gridColor": "#dedfd4",
      "labelColor": "#747c6f",
      "titleColor": "#747c6f",
      "titleFontWeight": "normal",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "labelPadding": 7,
      "titlePadding": 14,
      "labelLimit": 130
    },
    "legend": {
      "labelColor": "#21372b",
      "titleColor": "#747c6f",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "orient": "bottom",
      "titleFontWeight": "normal",
      "padding": 8
    },
    "range": {
      "category": [
        "#31553b",
        "#c96636",
        "#aa9148",
        "#838c76",
        "#637963"
      ]
    }
  },
  "description": "Connections between the home cities of Grand Final opponents. Line width represents the number of matchups, not physical journeys. Same-city final excluded.",
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -134,
      0,
      0
    ],
    "center": [
      0,
      -28
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e3e6d9",
        "stroke": "#f7f6ef",
        "strokeWidth": 1.2
      }
    },
    {
      "data": {
        "url": "data/finals_connections.json"
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#31553b",
        "opacity": 0.65
      },
      "encoding": {
        "strokeWidth": {
          "field": "properties.count",
          "type": "quantitative",
          "scale": {
            "domain": [
              1,
              5
            ],
            "range": [
              1.5,
              9
            ]
          },
          "legend": {
            "title": "Grand Final meetings",
            "values": [
              1,
              3,
              5
            ],
            "orient": "bottom"
          }
        },
        "tooltip": [
          {
            "field": "properties.pair",
            "type": "nominal",
            "title": "Club home cities"
          },
          {
            "field": "properties.count",
            "type": "quantitative",
            "title": "Meetings"
          },
          {
            "field": "properties.years",
            "type": "nominal",
            "title": "Seasons"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/cities.json"
      },
      "transform": [
        {
          "filter": "datum.grand_finals > 0"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#31553b",
        "opacity": 1,
        "size": 45,
        "stroke": "#f3f2e9",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "city",
            "title": "Home city",
            "type": "nominal"
          },
          {
            "field": "grand_finals",
            "title": "Grand Final appearances",
            "type": "quantitative"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/cities.json"
      },
      "transform": [
        {
          "filter": "datum.grand_finals > 0 && datum.city !== 'Geelong' && datum.city !== 'Melbourne'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 7,
        "dy": -8,
        "fontSize": 10,
        "color": "#21372b"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "city",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "data/cities.json"
      },
      "transform": [
        {
          "filter": "datum.city === 'Melbourne'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 15,
        "dy": -6,
        "fontSize": 10,
        "color": "#21372b"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "city",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "data/cities.json"
      },
      "transform": [
        {
          "filter": "datum.city === 'Geelong'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -7,
        "dy": 20,
        "fontSize": 10,
        "color": "#21372b"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "city",
          "type": "nominal"
        }
      }
    }
  ]
}
