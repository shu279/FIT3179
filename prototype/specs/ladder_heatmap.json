{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 530,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": 5,
  "config": {
    "background": "transparent",
    "font": "Helvetica Neue, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "tickColor": "#dedfd4",
      "gridColor": "#dedfd4",
      "labelColor": "#21372b",
      "titleColor": "#21372b",
      "titleFontWeight": "normal",
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelPadding": 9,
      "titlePadding": 14,
      "labelOverlap": true,
      "labelLimit": 150
    },
    "legend": {
      "labelColor": "#21372b",
      "titleColor": "#21372b",
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "titleFontWeight": "normal",
      "padding": 8
    },
    "range": {
      "category": [
        "#31553b",
        "#c96636",
        "#aa9148",
        "#838c76",
        "#637963"
      ]
    }
  },
  "description": "Regular-season ladder position, sorted by seasons reaching finals. Highlight a club using the bound dropdown.",
  "data": {
    "url": "data/team_seasons.json"
  },
  "params": [
    {
      "name": "focusTeam",
      "value": "All clubs",
      "bind": {
        "input": "select",
        "options": [
          "All clubs",
          "Adelaide",
          "Brisbane Lions",
          "Carlton",
          "Collingwood",
          "Essendon",
          "Fremantle",
          "GWS Giants",
          "Geelong",
          "Gold Coast",
          "Hawthorn",
          "Melbourne",
          "North Melbourne",
          "Port Adelaide",
          "Richmond",
          "St Kilda",
          "Sydney",
          "West Coast",
          "Western Bulldogs"
        ],
        "name": "Highlight a club: "
      }
    }
  ],
  "transform": [
    {
      "calculate": "datum.premier === 1 ? 'Yes' : 'No'",
      "as": "won_premiership"
    }
  ],
  "encoding": {
    "x": {
      "field": "season",
      "type": "ordinal",
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelFontSize": 15,
        "labelExpr": "width < 420 ? (datum.value == 2012 || datum.value == 2018 || datum.value == 2025 ? datum.label : '') : datum.label"
      }
    },
    "y": {
      "field": "team",
      "type": "nominal",
      "sort": [
        "Geelong",
        "Sydney",
        "Hawthorn",
        "Collingwood",
        "Richmond",
        "GWS Giants",
        "Port Adelaide",
        "Western Bulldogs",
        "Brisbane Lions",
        "West Coast",
        "Fremantle",
        "Adelaide",
        "Essendon",
        "Melbourne",
        "North Melbourne",
        "Carlton",
        "St Kilda",
        "Gold Coast"
      ],
      "axis": {
        "title": null,
        "labelFontSize": 15,
        "ticks": false,
        "labelLimit": 150
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#f4f3eb",
        "strokeWidth": 3,
        "cornerRadius": 2
      },
      "encoding": {
        "color": {
          "field": "band",
          "type": "nominal",
          "scale": {
            "domain": [
              "Top four",
              "5th–8th",
              "9th–18th"
            ],
            "range": [
              "#31553b",
              "#a8bd9c",
              "#e4e6da"
            ]
          },
          "legend": null
        },
        "opacity": {
          "condition": {
            "test": "focusTeam === 'All clubs' || datum.team === focusTeam",
            "value": 1
          },
          "value": 0.22
        },
        "tooltip": [
          {
            "field": "team",
            "title": "Club",
            "type": "nominal"
          },
          {
            "field": "season",
            "title": "Season",
            "type": "quantitative"
          },
          {
            "field": "rank",
            "title": "Ladder position",
            "type": "quantitative"
          },
          {
            "field": "wins",
            "title": "Wins",
            "type": "quantitative"
          },
          {
            "field": "win_rate",
            "title": "Win rate (%)",
            "format": ".1f",
            "type": "quantitative"
          },
          {
            "field": "won_premiership",
            "type": "nominal",
            "title": "Premier"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 15,
        "fontWeight": 500
      },
      "encoding": {
        "text": {
          "condition": {
            "test": "width >= 420",
            "field": "rank",
            "type": "quantitative"
          },
          "value": ""
        },
        "color": {
          "condition": {
            "test": "datum.rank <= 4",
            "value": "#ffffff"
          },
          "value": "#21372b"
        },
        "opacity": {
          "condition": {
            "test": "focusTeam === 'All clubs' || datum.team === focusTeam",
            "value": 1
          },
          "value": 0.22
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.premier === 1"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "diamond",
        "filled": true,
        "size": 19,
        "color": "#c96636"
      },
      "encoding": {
        "opacity": {
          "condition": {
            "test": "focusTeam === 'All clubs' || datum.team === focusTeam",
            "value": 1
          },
          "value": 0.22
        },
        "xOffset": {
          "value": 0
        },
        "yOffset": {
          "value": -10
        }
      }
    }
  ]
}
