{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 440,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": 5,
  "config": {
    "background": "transparent",
    "font": "Helvetica Neue, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "tickColor": "#dedfd4",
      "gridColor": "#dedfd4",
      "labelColor": "#21372b",
      "titleColor": "#21372b",
      "titleFontWeight": "normal",
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelPadding": 9,
      "titlePadding": 14,
      "labelOverlap": true,
      "labelLimit": 150
    },
    "legend": {
      "labelColor": "#21372b",
      "titleColor": "#21372b",
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "titleFontWeight": "normal",
      "padding": 8
    },
    "range": {
      "category": [
        "#31553b",
        "#c96636",
        "#aa9148",
        "#838c76",
        "#637963"
      ]
    }
  },
  "usermeta": {
    "layout": "map"
  },
  "description": "Week 10 long-table lookup and year selection, with Week 8 threshold classes. The map stays at a fixed national view with Natural Earth physical and cultural layers over a rectangular ocean background.",
  "title": {
    "text": {
      "expr": "'State finals rate · ' + selectedSeason"
    },
    "anchor": "start",
    "fontSize": 15,
    "color": "#21372b",
    "fontWeight": "normal",
    "limit": {
      "expr": "width"
    }
  },
  "params": [
    {
      "name": "selectedSeason",
      "value": 2025,
      "bind": {
        "input": "range",
        "min": 2012,
        "max": 2025,
        "step": 1,
        "name": "Season (all maps): "
      }
    },
    {
      "name": "mapZoom",
      "value": 1
    },
    {
      "name": "mapCentre",
      "value": [
        0,
        -28
      ]
    },
    {
      "name": "showPhysical",
      "value": true
    },
    {
      "name": "showCultural",
      "value": true
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -134,
      0,
      0
    ],
    "parallels": [
      -18,
      -36
    ],
    "center": {
      "expr": "mapCentre"
    },
    "scale": {
      "expr": "mapZoom * min(width / 0.84, height / 0.72)"
    },
    "translate": {
      "expr": "[width / 2, height / 2]"
    }
  },
  "layer": [
    {
      "name": "water_backdrop",
      "data": {
        "values": [
          {}
        ]
      },
      "transform": [
        {
          "filter": "showPhysical"
        }
      ],
      "mark": {
        "type": "rect",
        "clip": true,
        "fill": "#e4eff0",
        "stroke": null,
        "aria": false
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "x2": {
          "value": {
            "expr": "width"
          }
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": {
            "expr": "height"
          }
        }
      }
    },
    {
      "name": "physical_ocean",
      "data": {
        "url": "data/natural_earth_physical.topojson",
        "format": {
          "type": "topojson",
          "feature": "ocean"
        }
      },
      "transform": [
        {
          "filter": "showPhysical"
        }
      ],
      "mark": {
        "type": "geoshape",
        "clip": true,
        "fill": "#e4eff0",
        "stroke": null
      }
    },
    {
      "name": "physical_land",
      "data": {
        "url": "data/natural_earth_physical.topojson",
        "format": {
          "type": "topojson",
          "feature": "land"
        }
      },
      "transform": [
        {
          "filter": "showPhysical"
        }
      ],
      "mark": {
        "type": "geoshape",
        "clip": true,
        "fill": "#e5e6da",
        "stroke": "#adb7a5",
        "strokeWidth": 0.6
      }
    },
    {
      "name": "reference_grid",
      "data": {
        "url": "data/natural_earth_physical.topojson",
        "format": {
          "type": "topojson",
          "feature": "graticules"
        }
      },
      "transform": [
        {
          "filter": "showPhysical"
        }
      ],
      "mark": {
        "type": "geoshape",
        "clip": true,
        "filled": false,
        "stroke": "#bccbca",
        "strokeWidth": 0.6,
        "strokeDash": [
          3,
          3
        ]
      }
    },
    {
      "name": "state_rates",
      "data": {
        "url": "data/state_seasons.json"
      },
      "transform": [
        {
          "filter": "datum.season === selectedSeason"
        },
        {
          "calculate": "datum.clubs > 0 ? format(datum.finals_rate, '.1f') + '%' : 'Not applicable'",
          "as": "rate_label"
        },
        {
          "lookup": "state_code",
          "from": {
            "data": {
              "url": "data/natural_earth_states.topojson",
              "format": {
                "type": "topojson",
                "feature": "states"
              }
            },
            "key": "properties.state_code"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "clip": true,
        "stroke": null,
        "invalid": null
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "finals_rate",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              20,
              40,
              60,
              80
            ],
            "range": [
              "#ffffcc",
              "#a1dab4",
              "#41b6c4",
              "#2c7fb8",
              "#253494"
            ]
          },
          "legend": null,
          "condition": {
            "test": "datum.clubs === 0",
            "value": "#dedfd5"
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "season",
            "type": "quantitative",
            "format": "d",
            "title": "Season"
          },
          {
            "field": "clubs",
            "type": "quantitative",
            "title": "Clubs based here"
          },
          {
            "field": "finals",
            "type": "quantitative",
            "title": "Clubs reaching finals"
          },
          {
            "field": "rate_label",
            "type": "nominal",
            "title": "Finals rate"
          },
          {
            "field": "coverage",
            "type": "nominal",
            "title": "Coverage"
          }
        ]
      }
    },
    {
      "name": "cultural_borders",
      "data": {
        "url": "data/natural_earth_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "transform": [
        {
          "filter": "showCultural"
        }
      ],
      "mark": {
        "type": "geoshape",
        "clip": true,
        "filled": false,
        "stroke": "#748679",
        "strokeWidth": 0.8
      }
    },
    {
      "name": "cultural_state_labels",
      "data": {
        "url": "data/state_seasons.json"
      },
      "transform": [
        {
          "filter": "showCultural && datum.season === selectedSeason"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "values": [
                {
                  "state": "WA",
                  "lon": 122,
                  "lat": -26
                },
                {
                  "state": "NT",
                  "lon": 133,
                  "lat": -21
                },
                {
                  "state": "SA",
                  "lon": 135,
                  "lat": -30
                },
                {
                  "state": "QLD",
                  "lon": 145,
                  "lat": -22
                },
                {
                  "state": "NSW",
                  "lon": 147,
                  "lat": -32
                },
                {
                  "state": "VIC",
                  "lon": 143,
                  "lat": -36.7
                },
                {
                  "state": "TAS",
                  "lon": 146.5,
                  "lat": -42
                }
              ]
            },
            "key": "state",
            "fields": [
              "lon",
              "lat"
            ]
          }
        },
        {
          "filter": "isValid(datum.lon)"
        }
      ],
      "mark": {
        "type": "text",
        "clip": true,
        "fontSize": 15,
        "fontWeight": 600
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "state",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.clubs > 0 && datum.finals_rate >= 60",
            "value": "#ffffff"
          },
          "value": "#21372b"
        }
      }
    }
  ]
}
