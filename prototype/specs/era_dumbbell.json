{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 475,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": 5,
  "config": {
    "background": "transparent",
    "font": "Helvetica Neue, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "tickColor": "#dedfd4",
      "gridColor": "#dedfd4",
      "labelColor": "#747c6f",
      "titleColor": "#747c6f",
      "titleFontWeight": "normal",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "labelPadding": 7,
      "titlePadding": 14,
      "labelLimit": 130
    },
    "legend": {
      "labelColor": "#21372b",
      "titleColor": "#747c6f",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "orient": "bottom",
      "titleFontWeight": "normal",
      "padding": 8
    },
    "range": {
      "category": [
        "#31553b",
        "#c96636",
        "#aa9148",
        "#838c76",
        "#637963"
      ]
    }
  },
  "description": "Aggregate regular-season win rate in 2012–2018 compared with 2019–2025. Denominators use games played in each period.",
  "data": {
    "url": "data/team_summary.json"
  },
  "encoding": {
    "y": {
      "field": "team",
      "type": "nominal",
      "sort": {
        "field": "change",
        "order": "descending"
      },
      "axis": {
        "title": null,
        "ticks": false
      }
    },
    "x": {
      "field": "early_rate",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "axis": {
        "title": "Regular-season games won (%)",
        "tickCount": 6
      }
    },
    "tooltip": [
      {
        "field": "team",
        "title": "Club",
        "type": "nominal"
      },
      {
        "field": "early_rate",
        "title": "2012–2018 win rate (%)",
        "format": ".1f",
        "type": "quantitative"
      },
      {
        "field": "recent_rate",
        "title": "2019–2025 win rate (%)",
        "format": ".1f",
        "type": "quantitative"
      },
      {
        "field": "change",
        "title": "Change (percentage points)",
        "format": "+.1f",
        "type": "quantitative"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2.5,
        "color": "#b5c3a8"
      },
      "encoding": {
        "x2": {
          "field": "recent_rate",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "fill": "#f3f2e9",
        "stroke": "#31553b",
        "strokeWidth": 1.5,
        "size": 60
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80
      },
      "encoding": {
        "x": {
          "field": "recent_rate",
          "type": "quantitative"
        },
        "color": {
          "condition": {
            "test": "datum.change >= 0",
            "value": "#31553b"
          },
          "value": "#c96636"
        }
      }
    }
  ]
}
