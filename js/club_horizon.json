  "scales": [
    {
      "name": "year",
      "type": "linear",
      "domain": [
        2012,
        2025
      ],
      "range": [
        {
          "signal": "plotLeft"
        },
        {
          "signal": "width - readoutWidth"
        }
      ],
      "zero": false,
      "nice": false
    }
  ],
  "axes": [
    {
      "scale": "year",
      "orient": "bottom",
      "values": {
        "signal": "plotWidth >= 700 ? sequence(2012,2026) : plotWidth >= 180 ? [2012,2018,2025] : [2012,2025]"
      },
      "format": "d",
      "domain": false,
      "tickColor": "#cdd2c2",
      "labelPadding": 9,
      "labelFont": "Helvetica Neue, Arial, sans-serif",
      "labelFontSize": 15,
      "labelColor": "#21372b",
      "encode": {
        "labels": {
          "update": {
            "align": {
              "signal": "datum.value === 2012 ? 'left' : datum.value === 2025 ? 'right' : 'center'"
            }
          }
        }
      }
    }
  ],
