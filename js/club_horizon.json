{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "background": "transparent",
  "width": 700,
  "autosize": {
    "type": "none",
    "contains": "padding",
    "resize": true
  },
  "height": 384,
  "padding": {
    "top": 4,
    "left": 4,
    "right": 4,
    "bottom": 32
  },
  "description": "Six small-multiple area charts show annual win rates on the same 0–100% scale. Dark-green height is directly proportional to games won; the pale-green remainder completes 100%. Club names and percentages flank each compact strip. All six strips count as one chart. Hover reports real season records.",
  "signals": [
    {
      "name": "detailSeason",
      "value": 2025,
      "on": [
        {
          "events": "@season_targets:pointermove, @season_targets:click",
          "update": "datum.season"
        }
      ]
    },
    {
      "name": "compact",
      "update": "width < 650"
    },
    {
      "name": "plotLeft",
      "update": "compact ? 104 : 128"
    },
    {
      "name": "readoutWidth",
      "value": 58
    },
    {
      "name": "plotWidth",
      "update": "width - plotLeft - readoutWidth"
    }
  ],
  "data": [
    {
      "name": "curves",
      "url": "data/club_win_rate_horizon.json?v=32a16b265d62"
    },
    {
      "name": "records",
      "url": "data/team_seasons.json",
      "transform": [
        {
          "type": "filter",
          "expr": "indexof([\"Geelong\",\"Sydney\",\"Hawthorn\",\"Richmond\",\"Brisbane Lions\",\"West Coast\"],datum.team) >= 0"
        }
      ]
    },
    {
      "name": "curve_0",
      "source": "curves",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.team === \"Geelong\""
        }
      ]
    },
    {
      "name": "records_0",
      "source": "records",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.team === \"Geelong\""
        }
      ]
    },
    {
      "name": "detail_0",
      "source": "records_0",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.season === detailSeason"
        }
      ]
    },
    {
      "name": "curve_1",
      "source": "curves",
      "transform": [
        {
          "type": "filter",
