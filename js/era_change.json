{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 475,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": 5,
  "config": {
    "background": "transparent",
    "font": "Helvetica Neue, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "tickColor": "#dedfd4",
      "gridColor": "#dedfd4",
      "labelColor": "#21372b",
      "titleColor": "#21372b",
      "titleFontWeight": "normal",
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelPadding": 9,
      "titlePadding": 14,
      "labelOverlap": true,
      "labelLimit": 150
    },
    "legend": {
      "labelColor": "#21372b",
      "titleColor": "#21372b",
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "titleFontWeight": "normal",
      "padding": 8
    },
    "range": {
      "category": [
        "#31553b",
        "#c96636",
        "#aa9148",
        "#838c76",
        "#637963"
      ]
    }
  },
  "description": "Change in aggregate regular-season win rate from 2012–2018 to 2019–2025, in percentage points. Positive values indicate improvement.",
  "data": {
    "url": "data/team_summary.json"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 17
      },
      "encoding": {
        "y": {
          "field": "team",
          "type": "nominal",
          "sort": {
            "field": "change",
            "order": "descending"
          },
          "axis": {
            "title": null,
            "ticks": false
          }
        },
        "x": {
          "field": "change",
          "type": "quantitative",
          "scale": {
            "domain": [
              -45,
              45
            ],
            "nice": false
          },
          "axis": {
            "title": "Change (pp)",
            "values": [
              -40,
              -20,
              0,
              20,
              40
            ],
            "format": "+d"
          }
        },
        "color": {
          "condition": {
            "test": "datum.change >= 0",
            "value": "#c96636"
          },
          "value": "#31553b"
        },
        "tooltip": [
          {
            "field": "team",
            "title": "Club",
            "type": "nominal"
          },
          {
            "field": "early_rate",
            "title": "2012–2018 win rate (%)",
            "format": ".1f",
            "type": "quantitative"
          },
          {
            "field": "recent_rate",
            "title": "2019–2025 win rate (%)",
            "format": ".1f",
            "type": "quantitative"
          },
          {
            "field": "change",
            "title": "Change (percentage points)",
            "format": "+.1f",
            "type": "quantitative"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#21372b",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "datum": 0
        }
      }
    },
    {
      "name": "rise_note",
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 15,
        "lineHeight": 19,
        "lineBreak": "\n",
        "color": "#21372b"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "3"
          }
        },
        "y": {
          "value": {
            "expr": "scale('y','Brisbane Lions') + 18"
          }
        },
        "text": {
          "value": "Brisbane\n+41.8\npoints"
        },
        "tooltip": {
          "value": null
        },
        "opacity": {
          "value": 1
        },
        "color": {
          "value": "#21372b"
        }
      }
    },
    {
      "name": "rise_leader",
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#21372b",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width * .25"
          }
        },
        "y": {
          "value": {
            "expr": "scale('y','Brisbane Lions') + 13"
          }
        },
        "x2": {
          "value": {
            "expr": "scale('x',0) - 5"
          }
        },
        "y2": {
          "value": {
            "expr": "scale('y','Brisbane Lions') + bandwidth('y')/2"
          }
        },
        "tooltip": {
          "value": null
        },
        "opacity": {
          "value": 1
        },
        "color": {
          "value": "#21372b"
        }
      }
    },
    {
      "name": "fall_note",
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 15,
        "lineHeight": 19,
        "lineBreak": "\n",
        "color": "#21372b"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width * .52"
          }
        },
        "y": {
          "value": {
            "expr": "scale('y','West Coast') - 65"
          }
        },
        "text": {
          "value": {
            "expr": "width < 200 ? 'West\\nCoast\\n−30.1 pts' : 'West Coast\\n−30.1 points'"
          }
        },
        "tooltip": {
          "value": null
        },
        "opacity": {
          "value": 1
        },
        "color": {
          "value": "#21372b"
        }
      }
    },
    {
      "name": "fall_leader",
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#21372b",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width * .72"
          }
        },
        "y": {
          "value": {
            "expr": "scale('y','West Coast') + 8"
          }
        },
        "x2": {
          "value": {
            "expr": "scale('x',0) + 5"
          }
        },
        "y2": {
          "value": {
            "expr": "scale('y','West Coast') + bandwidth('y')/2"
          }
        },
        "tooltip": {
          "value": null
        },
        "opacity": {
          "value": 1
        },
        "color": {
          "value": "#21372b"
        }
      }
    },
    {
      "name": "rise_arrow",
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "point",
        "shape": "triangle-right",
        "filled": true,
        "color": "#21372b",
        "size": 35
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "scale('x',0)-5"
          }
        },
        "y": {
          "value": {
            "expr": "scale('y','Brisbane Lions') + bandwidth('y')/2"
          }
        }
      }
    },
    {
      "name": "fall_arrow",
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "point",
        "shape": "triangle-left",
        "filled": true,
        "color": "#21372b",
        "size": 35
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "scale('x',0)+5"
          }
        },
        "y": {
          "value": {
            "expr": "scale('y','West Coast') + bandwidth('y')/2"
          }
        }
      }
    }
  ]
}
