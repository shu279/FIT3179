{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "A proportional-symbol map linked to an interval brush. Area shows finalists per season, colour uses the same five finals-rate classes as the state map. For a single selected season, a diamond and annotation identify its champion. Both disappear when comparing multiple seasons.",
  "usermeta": {
    "layout": "map-timeline"
  },
  "padding": 5,
  "autosize": {
    "type": "pad",
    "resize": true
  },
  "config": {
    "background": "transparent",
    "font": "Helvetica Neue, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "tickColor": "#dedfd4",
      "gridColor": "#dedfd4",
      "labelColor": "#21372b",
      "titleColor": "#21372b",
      "titleFontWeight": "normal",
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelPadding": 9,
      "titlePadding": 14,
      "labelOverlap": true,
      "labelLimit": 150
    },
    "legend": {
      "labelColor": "#21372b",
      "titleColor": "#21372b",
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "titleFontWeight": "normal",
      "padding": 8
    },
    "range": {
      "category": [
        "#31553b",
        "#c96636",
        "#aa9148",
        "#838c76",
        "#637963"
      ]
    },
    "title": {
      "fontSize": 15,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#21372b",
      "offset": 14
    },
    "header": {
      "labelFontSize": 15,
      "labelColor": "#21372b",
      "labelFontWeight": 600,
      "titleFontSize": 15
    }
  },
  "params": [
    {
      "name": "selectedSeason",
      "value": 2025,
      "bind": {
        "input": "range",
        "min": 2012,
        "max": 2025,
        "step": 1,
        "name": "Season: "
      }
    },
    {
      "name": "mapZoom",
      "value": 1,
      "bind": {
        "input": "range",
        "min": 1,
        "max": 8,
        "step": 0.25,
        "name": "Zoom: ",
        "element": "#city-zoom-control"
      }
    },
    {
      "name": "mapCentre",
      "value": [
        0,
        -28
      ]
    },
    {
      "name": "showPhysical",
      "value": true
    },
    {
      "name": "showCultural",
      "value": true
    },
    {
      "name": "mapPan",
      "value": [
        0,
        0
      ]
    },
    {
      "name": "usePeriod",
      "value": false,
      "bind": {
        "input": "checkbox",
        "name": "Compare the brushed period: "
      }
    }
  ],
  "spacing": 28,
  "vconcat": [
    {
      "name": "city_map",
      "width": 900,
      "height": 440,
      "projection": {
        "type": "conicEqualArea",
        "rotate": [
          -134,
          0,
          0
        ],
        "parallels": [
          -18,
          -36
        ],
        "center": {
          "expr": "mapCentre"
        },
        "scale": {
          "expr": "mapZoom * min(width / 0.84, city_map_height / 0.72)"
        },
        "translate": {
          "expr": "[width * (0.5 + mapPan[0]), city_map_height * (0.5 + mapPan[1])]"
        }
      },
      "layer": [
        {
          "name": "water_backdrop",
          "data": {
            "values": [
              {}
            ]
          },
          "transform": [
            {
              "filter": "showPhysical"
            }
          ],
          "mark": {
            "type": "rect",
            "clip": true,
            "fill": "#e4eff0",
            "stroke": null,
            "aria": false
          },
          "encoding": {
            "x": {
              "value": 0
            },
            "x2": {
              "value": {
                "expr": "width"
              }
            },
            "y": {
              "value": 0
            },
            "y2": {
              "value": {
                "expr": "city_map_height"
              }
            }
          }
        },
        {
          "name": "physical_ocean",
          "data": {
            "url": "data/natural_earth_physical.topojson",
            "format": {
              "type": "topojson",
              "feature": "ocean"
            }
          },
          "transform": [
            {
              "filter": "showPhysical"
            }
          ],
          "mark": {
            "type": "geoshape",
            "clip": true,
            "fill": "#e4eff0",
            "stroke": null
          }
        },
        {
          "name": "physical_land",
          "data": {
            "url": "data/natural_earth_physical.topojson",
            "format": {
              "type": "topojson",
              "feature": "land"
            }
          },
          "transform": [
            {
              "filter": "showPhysical"
            }
          ],
          "mark": {
            "type": "geoshape",
            "clip": true,
            "fill": "#e5e6da",
            "stroke": "#adb7a5",
            "strokeWidth": 0.6
          }
        },
        {
          "name": "reference_grid",
          "data": {
            "url": "data/natural_earth_physical.topojson",
            "format": {
              "type": "topojson",
              "feature": "graticules"
            }
          },
          "transform": [
            {
              "filter": "showPhysical"
            }
          ],
          "mark": {
            "type": "geoshape",
            "clip": true,
            "filled": false,
            "stroke": "#bccbca",
            "strokeWidth": 0.6,
            "strokeDash": [
              3,
              3
            ]
          }
        },
        {
          "name": "cultural_borders",
          "data": {
            "url": "data/natural_earth_states.topojson",
            "format": {
              "type": "topojson",
              "feature": "states"
            }
          },
          "transform": [
            {
              "filter": "showCultural"
            }
          ],
          "mark": {
            "type": "geoshape",
            "clip": true,
            "filled": false,
            "stroke": "#748679",
            "strokeWidth": 0.8
          }
        },
        {
          "name": "city_symbols",
          "data": {
            "url": "data/city_seasons.json"
          },
          "transform": [
            {
              "filter": {
                "or": [
                  {
                    "and": [
                      "usePeriod",
                      {
                        "param": "mapTimeBrush"
                      }
                    ]
                  },
                  "!usePeriod && datum.season === selectedSeason"
                ]
              }
            },
            {
              "aggregate": [
                {
                  "op": "sum",
                  "field": "finals",
                  "as": "finals"
                },
                {
                  "op": "sum",
                  "field": "clubs",
                  "as": "club_seasons"
                },
                {
                  "op": "count",
                  "as": "season_count"
                },
                {
                  "op": "min",
                  "field": "season",
                  "as": "first"
                },
                {
                  "op": "max",
                  "field": "season",
                  "as": "last"
                }
              ],
              "groupby": [
                "city",
                "longitude",
                "latitude"
              ]
            },
            {
              "calculate": "datum.finals / datum.club_seasons * 100",
              "as": "finals_rate"
            },
            {
              "calculate": "datum.finals / datum.season_count",
              "as": "finals_per_season"
            }
          ],
          "mark": {
            "type": "circle",
            "clip": true,
            "stroke": "#21372b",
            "strokeWidth": 1,
            "opacity": 0.85
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "color": {
              "field": "finals_rate",
              "type": "quantitative",
              "scale": {
                "type": "threshold",
                "domain": [
                  20,
                  40,
                  60,
                  80
                ],
                "range": [
                  "#ffffcc",
                  "#a1dab4",
                  "#41b6c4",
                  "#2c7fb8",
                  "#253494"
                ]
              },
              "legend": null
            },
            "size": {
              "field": "finals_per_season",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  9
                ],
                "range": [
                  0,
                  2400
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "city",
                "type": "nominal",
                "title": "Home city"
              },
              {
                "field": "first",
                "type": "quantitative",
                "format": "d",
                "title": "First season"
              },
              {
                "field": "last",
                "type": "quantitative",
                "format": "d",
                "title": "Last season"
              },
              {
                "field": "finals",
                "type": "quantitative",
                "title": "Finals appearances"
              },
              {
                "field": "club_seasons",
                "type": "quantitative",
                "title": "Club-seasons"
              },
              {
                "field": "finals_per_season",
                "type": "quantitative",
                "format": ".2f",
                "title": "Finalists per season"
              },
              {
                "field": "finals_rate",
                "type": "quantitative",
                "format": ".1f",
                "title": "Finals rate (%)"
              }
            ]
          }
        },
        {
          "name": "zero_city_symbols",
          "data": {
            "url": "data/city_seasons.json"
          },
          "transform": [
            {
              "filter": {
                "or": [
                  {
                    "and": [
                      "usePeriod",
                      {
                        "param": "mapTimeBrush"
                      }
                    ]
                  },
                  "!usePeriod && datum.season === selectedSeason"
                ]
              }
            },
            {
              "aggregate": [
                {
                  "op": "sum",
                  "field": "finals",
                  "as": "finals"
                },
                {
                  "op": "sum",
                  "field": "clubs",
                  "as": "club_seasons"
                },
                {
                  "op": "count",
                  "as": "season_count"
                },
                {
                  "op": "min",
                  "field": "season",
                  "as": "first"
                },
                {
                  "op": "max",
                  "field": "season",
                  "as": "last"
                }
              ],
              "groupby": [
                "city",
                "longitude",
                "latitude"
              ]
            },
            {
              "calculate": "datum.finals / datum.club_seasons * 100",
              "as": "finals_rate"
            },
            {
              "calculate": "datum.finals / datum.season_count",
              "as": "finals_per_season"
            },
            {
              "filter": "datum.finals === 0"
            }
          ],
          "mark": {
            "type": "point",
            "clip": true,
            "shape": "circle",
            "size": 35,
            "filled": false,
            "stroke": "#21372b",
            "strokeWidth": 1.2
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "tooltip": [
              {
                "field": "city",
                "type": "nominal",
                "title": "Home city"
              },
              {
                "field": "first",
                "type": "quantitative",
                "format": "d",
                "title": "First season"
              },
              {
                "field": "last",
                "type": "quantitative",
                "format": "d",
                "title": "Last season"
              },
              {
                "field": "finals",
                "type": "quantitative",
                "title": "Finals appearances"
              },
              {
                "field": "club_seasons",
                "type": "quantitative",
                "title": "Club-seasons"
              },
              {
                "field": "finals_per_season",
                "type": "quantitative",
                "format": ".2f",
                "title": "Finalists per season"
              },
              {
                "field": "finals_rate",
                "type": "quantitative",
                "format": ".1f",
                "title": "Finals rate (%)"
              }
            ]
          }
        },
        {
          "name": "premier_location",
          "data": {
            "url": "data/city_seasons.json"
          },
          "transform": [
            {
              "filter": {
                "or": [
                  {
                    "and": [
                      "usePeriod",
                      {
                        "param": "mapTimeBrush"
                      }
                    ]
                  },
                  "!usePeriod && datum.season === selectedSeason"
                ]
              }
            },
            {
              "joinaggregate": [
                {
                  "op": "distinct",
                  "field": "season",
                  "as": "visible_seasons"
                }
              ]
            },
            {
              "filter": "datum.visible_seasons === 1 && datum.premierships > 0"
            }
          ],
          "mark": {
            "type": "point",
            "clip": true,
            "shape": "diamond",
            "filled": true,
            "size": 180,
            "color": "#c96636",
            "stroke": "#ffffff",
            "strokeWidth": 1
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "tooltip": [
              {
                "field": "season",
                "type": "quantitative",
                "format": "d",
                "title": "Season"
              },
              {
                "field": "premier",
                "type": "nominal",
                "title": "Premier"
              },
              {
                "field": "city",
                "type": "nominal",
                "title": "Home city"
              }
            ]
          }
        },
        {
          "name": "cultural_city_labels",
          "data": {
            "url": "data/cities.json"
          },
          "transform": [
            {
              "filter": "(width >= 500 || mapZoom >= 2) && showCultural && datum.city !== 'Geelong' && datum.city !== 'Gold Coast'"
            }
          ],
          "mark": {
            "type": "text",
            "clip": true,
            "align": "left",
            "dx": 12,
            "dy": -12,
            "fontSize": 15,
            "color": "#21372b"
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "city",
              "type": "nominal"
            }
          }
        },
        {
          "name": "cultural_geelong_label",
          "data": {
            "url": "data/cities.json"
          },
          "transform": [
            {
              "filter": "(width >= 500 || mapZoom >= 2) && showCultural && datum.city === 'Geelong'"
            }
          ],
          "mark": {
            "type": "text",
            "clip": true,
            "align": "right",
            "dx": -12,
            "dy": 22,
            "fontSize": 15,
            "color": "#21372b"
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "city",
              "type": "nominal"
            }
          }
        },
        {
          "name": "cultural_gold_coast_label",
          "data": {
            "url": "data/cities.json"
          },
          "transform": [
            {
              "filter": "(width >= 500 || mapZoom >= 2) && showCultural && datum.city === 'Gold Coast'"
            }
          ],
          "mark": {
            "type": "text",
            "clip": true,
            "align": "left",
            "dx": 12,
            "dy": 19,
            "fontSize": 15,
            "color": "#21372b"
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "city",
              "type": "nominal"
            }
          }
        },
        {
          "data": {
            "url": "data/city_seasons.json"
          },
          "transform": [
            {
              "filter": {
                "or": [
                  {
                    "and": [
                      "usePeriod",
                      {
                        "param": "mapTimeBrush"
                      }
                    ]
                  },
                  "!usePeriod && datum.season === selectedSeason"
                ]
              }
            },
            {
              "joinaggregate": [
                {
                  "op": "distinct",
                  "field": "season",
                  "as": "visible_seasons"
                }
              ]
            },
            {
              "filter": "datum.visible_seasons === 1 && datum.premierships > 0"
            },
            {
              "calculate": "[format(datum.season, 'd') + ' champions', datum.premier]",
              "as": "champion_label"
            }
          ],
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "champion_label",
              "type": "nominal"
            }
          },
          "name": "champion_annotation_halo",
          "mark": {
            "type": "text",
            "clip": true,
            "fontSize": 15,
            "fontWeight": 600,
            "lineHeight": 18,
            "align": {
              "expr": "mapZoom > 1 ? 'center' : datum.city === 'Perth' ? 'left' : 'right'"
            },
            "dx": {
              "expr": "mapZoom > 1 ? 0 : datum.city === 'Perth' ? 16 : width < 500 && (datum.city === 'Melbourne' || datum.city === 'Geelong') ? 24 : -16"
            },
            "dy": {
              "expr": "mapZoom > 1 ? -54 : datum.city === 'Perth' ? -52 : datum.city === 'Melbourne' || datum.city === 'Geelong' ? (width >= 500 ? 44 : -42) : -36"
            },
            "fill": "#f3f2e9",
            "stroke": "#f3f2e9",
            "strokeWidth": 4,
            "aria": false
          }
        },
        {
          "data": {
            "url": "data/city_seasons.json"
          },
          "transform": [
            {
              "filter": {
                "or": [
                  {
                    "and": [
                      "usePeriod",
                      {
                        "param": "mapTimeBrush"
                      }
                    ]
                  },
                  "!usePeriod && datum.season === selectedSeason"
                ]
              }
            },
            {
              "joinaggregate": [
                {
                  "op": "distinct",
                  "field": "season",
                  "as": "visible_seasons"
                }
              ]
            },
            {
              "filter": "datum.visible_seasons === 1 && datum.premierships > 0"
            },
            {
              "calculate": "[format(datum.season, 'd') + ' champions', datum.premier]",
              "as": "champion_label"
            }
          ],
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "champion_label",
              "type": "nominal"
            }
          },
          "name": "champion_annotation",
          "mark": {
            "type": "text",
            "clip": true,
            "fontSize": 15,
            "fontWeight": 600,
            "lineHeight": 18,
            "align": {
              "expr": "mapZoom > 1 ? 'center' : datum.city === 'Perth' ? 'left' : 'right'"
            },
            "dx": {
              "expr": "mapZoom > 1 ? 0 : datum.city === 'Perth' ? 16 : width < 500 && (datum.city === 'Melbourne' || datum.city === 'Geelong') ? 24 : -16"
            },
            "dy": {
              "expr": "mapZoom > 1 ? -54 : datum.city === 'Perth' ? -52 : datum.city === 'Melbourne' || datum.city === 'Geelong' ? (width >= 500 ? 44 : -42) : -36"
            },
            "color": "#c96636"
          }
        }
      ]
    },
    {
      "name": "map_overview",
      "title": {
        "text": "Drag to select years",
        "anchor": "start",
        "fontSize": 15,
        "color": "#21372b",
        "fontWeight": "normal",
        "limit": {
          "expr": "width"
        }
      },
      "width": 900,
      "height": 100,
      "data": {
        "url": "data/city_seasons.json"
      },
      "transform": [
        {
          "filter": "datum.city === 'Melbourne'"
        }
      ],
      "params": [
        {
          "name": "mapTimeBrush",
          "select": {
            "type": "interval",
            "encodings": [
              "x"
            ],
            "mark": {
              "fill": "#31553b",
              "fillOpacity": 0.14,
              "stroke": "#31553b"
            }
          }
        }
      ],
      "mark": {
        "type": "line",
        "point": true,
        "color": "#31553b",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "season",
          "type": "quantitative",
          "scale": {
            "domain": [
              2012,
              2025
            ],
            "nice": false,
            "zero": false
          },
          "axis": {
            "title": null,
            "format": "d",
            "values": [
              2012,
              2015,
              2018,
              2021,
              2025
            ],
            "grid": false
          }
        },
        "y": {
          "field": "finals",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              5
            ],
            "nice": false
          },
          "axis": {
            "title": null,
            "values": [
              0,
              1,
              2,
              3,
              4,
              5
            ]
          }
        },
        "tooltip": [
          {
            "field": "season",
            "type": "quantitative",
            "format": "d",
            "title": "Season"
          },
          {
            "field": "finals",
            "type": "quantitative",
            "title": "Melbourne clubs reaching finals"
          },
          {
            "field": "finalists",
            "type": "nominal",
            "title": "Clubs"
          }
        ]
      }
    }
  ]
}
