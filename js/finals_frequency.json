{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 475,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": 5,
  "config": {
    "background": "transparent",
    "font": "Helvetica Neue, Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "tickColor": "#dedfd4",
      "gridColor": "#dedfd4",
      "labelColor": "#21372b",
      "titleColor": "#21372b",
      "titleFontWeight": "normal",
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelPadding": 9,
      "titlePadding": 14,
      "labelOverlap": true,
      "labelLimit": 150
    },
    "legend": {
      "labelColor": "#21372b",
      "titleColor": "#21372b",
      "labelFontSize": 15,
      "titleFontSize": 15,
      "orient": "bottom",
      "titleFontWeight": "normal",
      "padding": 8
    },
    "range": {
      "category": [
        "#31553b",
        "#c96636",
        "#aa9148",
        "#838c76",
        "#637963"
      ]
    }
  },
  "description": "Finals seasons out of fourteen. A single-line annotation points to Geelong and identifies its two missed seasons.",
  "data": {
    "url": "data/team_summary.json"
  },
  "params": [
    {
      "name": "focusTeam",
      "value": "All clubs"
    }
  ],
  "encoding": {
    "y": {
      "field": "team",
      "type": "nominal",
      "sort": [
        "Geelong",
        "Sydney",
        "Hawthorn",
        "Collingwood",
        "Richmond",
        "GWS Giants",
        "Port Adelaide",
        "Western Bulldogs",
        "Brisbane Lions",
        "West Coast",
        "Fremantle",
        "Adelaide",
        "Essendon",
        "Melbourne",
        "North Melbourne",
        "Carlton",
        "St Kilda",
        "Gold Coast"
      ],
      "scale": {
        "range": [
          0,
          {
            "expr": "width < 300 ? height - 90 : height"
          }
        ]
      },
      "axis": {
        "title": null,
        "ticks": false
      }
    },
    "x": {
      "field": "finals",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          18
        ]
      },
      "axis": {
        "title": "Finals seasons",
        "values": [
          0,
          4,
          8,
          12,
          14
        ]
      }
    },
    "opacity": {
      "condition": {
        "test": "focusTeam === 'All clubs' || datum.team === focusTeam",
        "value": 1
      },
      "value": 0.22
    },
    "tooltip": [
      {
        "field": "team",
        "title": "Club",
        "type": "nominal"
      },
      {
        "field": "finals",
        "title": "Finals seasons",
        "type": "quantitative"
      },
      {
        "field": "finals_rate",
        "title": "Share of seasons (%)",
        "format": ".1f",
        "type": "quantitative"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2,
        "color": "#b8c4af"
      },
      "encoding": {
        "x2": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 95,
        "color": "#31553b"
      }
    },
    {
      "transform": [
        {
          "calculate": "datum.finals >= 11 ? datum.finals + '/14' : '' + datum.finals",
          "as": "finals_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 9,
        "fontSize": 15,
        "color": "#21372b"
      },
      "encoding": {
        "text": {
          "field": "finals_label",
          "type": "nominal"
        }
      }
    },
    {
      "name": "finals_note_leader",
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#21372b",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width - 2"
          }
        },
        "y": {
          "value": {
            "expr": "width < 300 ? height - 43 : height * .68 - 8"
          }
        },
        "x2": {
          "value": {
            "expr": "width - 2"
          }
        },
        "y2": {
          "value": {
            "expr": "(scale('y','Geelong') + scale('y','Sydney') + bandwidth('y')) / 2"
          }
        },
        "tooltip": {
          "value": null
        },
        "opacity": {
          "value": 1
        },
        "color": {
          "value": "#21372b"
        }
      }
    },
    {
      "name": "finals_note_elbow",
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#21372b",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width - 2"
          }
        },
        "y": {
          "value": {
            "expr": "(scale('y','Geelong') + scale('y','Sydney') + bandwidth('y')) / 2"
          }
        },
        "x2": {
          "value": {
            "expr": "scale('x',12)"
          }
        },
        "y2": {
          "value": {
            "expr": "(scale('y','Geelong') + scale('y','Sydney') + bandwidth('y')) / 2"
          }
        },
        "tooltip": {
          "value": null
        },
        "opacity": {
          "value": 1
        },
        "color": {
          "value": "#21372b"
        }
      }
    },
    {
      "name": "finals_note_tip",
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#21372b",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "scale('x',12)"
          }
        },
        "y": {
          "value": {
            "expr": "(scale('y','Geelong') + scale('y','Sydney') + bandwidth('y')) / 2"
          }
        },
        "x2": {
          "value": {
            "expr": "scale('x',12)"
          }
        },
        "y2": {
          "value": {
            "expr": "scale('y','Geelong') + bandwidth('y')/2 + 8"
          }
        },
        "tooltip": {
          "value": null
        },
        "opacity": {
          "value": 1
        },
        "color": {
          "value": "#21372b"
        }
      }
    },
    {
      "name": "finals_note_arrow",
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "point",
        "shape": "triangle-up",
        "filled": true,
        "color": "#21372b",
        "size": 35
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "scale('x',12)"
          }
        },
        "y": {
          "value": {
            "expr": "scale('y','Geelong') + bandwidth('y')/2 + 8"
          }
        },
        "opacity": {
          "value": 1
        },
        "tooltip": {
          "value": null
        }
      }
    },
    {
      "name": "finals_note",
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "lineHeight": 19,
        "lineBreak": "\n",
        "color": "#21372b",
        "fontSize": 15,
        "fontWeight": "normal"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width - 6"
          }
        },
        "y": {
          "value": {
            "expr": "width < 300 ? height - 35 : height * .68"
          }
        },
        "text": {
          "value": "Missed finals in 2015 and 2023."
        },
        "tooltip": {
          "value": null
        },
        "opacity": {
          "value": 1
        },
        "color": {
          "value": "#21372b"
        }
      }
    }
  ]
}
